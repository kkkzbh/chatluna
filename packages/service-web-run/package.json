{
    "name": "koishi-plugin-chatluna-web-run-service",
    "description": "Structured web.run support for ChatLuna",
    "version": "1.4.0-alpha.1",
    "main": "lib/index.cjs",
    "module": "lib/index.mjs",
    "typings": "lib/index.d.ts",
    "files": [
        "lib",
        "dist"
    ],
    "exports": {
        ".": {
            "types": "./lib/index.d.ts",
            "import": "./lib/index.mjs",
            "require": "./lib/index.cjs"
        },
        "./package.json": "./package.json"
    },
    "type": "module",
    "author": "dingyi222666 <dingyi222666@foxmail.com>",
    "repository": {
        "type": "git",
        "url": "https://github.com/ChatLunaLab/chatluna.git",
        "directory": "packages/service-web-run"
    },
    "license": "AGPL-3.0",
    "bugs": {
        "url": "https://github.com/ChatLunaLab/chatluna/issues"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "homepage": "https://github.com/ChatLunaLab/chatluna/tree/v1-dev/packages/service-web-run#readme",
    "scripts": {
        "build": "atsc -b"
    },
    "resolutions": {
        "@langchain/core": "^0.3.80",
        "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
    },
    "overrides": {
        "@langchain/core": "^0.3.80",
        "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
    },
    "pnpm": {
        "overrides": {
            "@langchain/core": "^0.3.80",
            "js-tiktoken": "npm:@dingyi222666/js-tiktoken@^1.0.21"
        }
    },
    "keywords": [
        "chatbot",
        "koishi",
        "plugin",
        "service",
        "chatgpt",
        "gpt",
        "openai",
        "chatluna",
        "search"
    ],
    "dependencies": {
        "@langchain/core": "^0.3.80",
        "@napi-rs/canvas": "^1.0.2",
        "pdfjs-dist": "^6.1.200",
        "undici": "^6.21.3",
        "zod": "3.25.76"
    },
    "devDependencies": {
        "atsc": "^2.1.0",
        "koishi": "^4.18.9",
        "koishi-plugin-puppeteer": "^3.9.0"
    },
    "peerDependencies": {
        "koishi": "^4.18.9",
        "koishi-plugin-chatluna": "^1.4.0-alpha.24",
        "koishi-plugin-puppeteer": "^3.9.0"
    },
    "peerDependenciesMeta": {
        "koishi-plugin-puppeteer": {
            "optional": true
        }
    },
    "koishi": {
        "description": {
            "zh": "ChatLuna 的结构化 web.run 服务，支持搜索、页面读取、PDF 截图和天气查询",
            "en": "Structured web.run service for search, page reading, PDF screenshots, and weather"
        },
        "service": {
            "required": [
                "chatluna",
                "database"
            ],
            "optional": [
                "puppeteer"
            ]
        }
    }
}
